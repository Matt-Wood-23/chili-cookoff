# Server configuration. Copy to .env to override.

# Port the API listens on
PORT=3001

# Shared admin password. Leave unset and admin endpoints stay open, which is
# fine for a laptop-only setup. Set it if judges are on the same wifi and you
# do not want a guest who finds /admin closing voting mid-event.
# ADMIN_TOKEN=

# Comma-separated list of allowed browser origins. Leave unset to accept any
# origin, which is what lets phones on the LAN connect.
# CLIENT_ORIGINS=http://192.168.1.50:5173

# Where the SQLite file lives (defaults to server/database.db)
# DATABASE_PATH=

# Ollama host for optional scoresheet OCR
# OLLAMA_HOST=http://localhost:11434
