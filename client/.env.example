# Client configuration (Vite). Copy to .env to override.
#
# By default the client talks to the same hostname it was served from, on port
# 3001 — which is what makes phones on the venue wifi work. Set these only if
# your API lives somewhere else.

# Full API origin, e.g. https://chili.example.com
# VITE_API_URL=

# Just the port, if the API is on the same host but not 3001
# VITE_API_PORT=3001
